#!/bin/sh
#
# This file is part of the openmediavault-garage plugin.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

remove_action() {
	####################################################################
	# Stop the instances the plugin rendered and remove their files. A
	# toml without the plugin's marker line is the admin's own.
	####################################################################
	echo "Removing Garage instances ..."
	for toml in /etc/garage/*.toml; do
		grep -qs '^# Managed by openmediavault-garage\.' "$toml" || continue
		name=$(basename "$toml" .toml)
		systemctl disable --now "garage@$name.service" \
			"omv-garage-webui@$name.service" >/dev/null 2>&1 || true
		rm -f "/etc/garage/$name.rpc_secret" "/etc/garage/$name.webui.env" \
			"/etc/nginx/openmediavault-webgui.d/garage-webui-$name.conf"
		rm -rf "/etc/systemd/system/garage@$name.service.d"
		rm -f "$toml"
	done
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi

	####################################################################
	# Activate trigger to rebuild workbench configuration files.
	####################################################################
	dpkg-trigger update-workbench
}

case "$1" in
	purge)
		remove_action
		echo "Revoking the garage ACLs the plugin granted ..."
		record=/var/lib/openmediavault-garage/acls.json
		if [ -f "$record" ]; then
			# shellcheck disable=SC2016
			php -r 'foreach (json_decode(file_get_contents($argv[1])) as $p) echo $p, "\0";' \
				"$record" | xargs -0 -r setfacl -x u:garage 2>/dev/null || true
		fi
		rm -rf /var/lib/openmediavault-garage
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/garage"
	;;
	remove)
		remove_action
	;;
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
