#!/usr/bin/env dash
#
# This file is part of the openmediavault-garage plugin.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

remove_action() {
	####################################################################
	# Stop and disable all Garage instances and web UIs.
	####################################################################
	echo "Stopping Garage instances ..."
	units=$(systemctl list-units --plain --no-legend \
		'garage@*.service' 'omv-garage-webui@*.service' 2>/dev/null | awk '{print $1}')
	if [ -n "$units" ]; then
		systemctl stop $units >/dev/null 2>&1 || true
		systemctl disable $units >/dev/null 2>&1 || true
	fi

	####################################################################
	# Remove rendered files.
	####################################################################
	echo "Removing Garage instance files ..."
	for f in /etc/garage/*.toml /etc/garage/*.rpc_secret /etc/garage/*.webui.env; do
		rm -f "$f"
	done
	rm -rf /etc/systemd/system/garage@*.service.d
	rm -f /etc/nginx/openmediavault-webgui.d/garage-webui-*.conf
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi

	####################################################################
	# Activate trigger to rebuild workbench configuration files.
	####################################################################
	dpkg-trigger update-workbench
}

case "$1" in
	purge)
		remove_action
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/garage"
	;;
	remove)
		remove_action
	;;
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;
	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
