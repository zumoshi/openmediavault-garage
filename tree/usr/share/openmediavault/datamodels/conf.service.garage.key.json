{
	"type": "config",
	"id": "conf.service.garage.key",
	"title": "Garage access key",
	"queryinfo": {
		"xpath": "/config/services/garage/keys/key",
		"iterable": true,
		"idproperty": "uuid"
	},
	"properties": {
		"uuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"instanceuuid": {
			"type": "string",
			"format": "uuidv4",
			"required": true
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"keyid": {
			"type": "string",
			"maxLength": 64,
			"default": ""
		},
		"secret": {
			"type": "string",
			"maxLength": 64,
			"default": ""
		}
	}
}
