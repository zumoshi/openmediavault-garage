                    "required": true
                },
                "maxobjects": {
                    "type": "integer",
                    "minimum": 0,
                    "required": true
                },
                "website": {
                    "type": "boolean"
                },
                "indexdoc": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "errordoc": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    },
    {
        "type": "rpc",
        "id": "rpc.garage.setkey",
        "params": {
            "type": "object",
            "properties": {
                "instanceuuid": {
                    "type": "string",
                    "format": "uuidv4",
