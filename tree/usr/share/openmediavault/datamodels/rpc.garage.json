[
    {
        "type": "rpc",
        "id": "rpc.garage.getlist",
        "params": {
            "type": "object",
            "properties": {
                "start": {
                    "type": "integer",
                    "required": true
                },
                "limit": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "required": true
                },
                "sortfield": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "sortdir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "asc",
                        "ASC",
                        "desc",
                        "DESC"
                    ]
                },
                "search": {
                    "type": [
                        "string",
                        "integer",
                        "null"
                    ]
                },
                "instanceuuid": {
                    "type": "string",
                    "format": "uuidv4",
                    "required": true
                }
            }
        }
    },
    {
        "type": "rpc",
        "id": "rpc.garage.setinstance",
        "params": {
            "type": "object",
            "properties": {
                "uuid": {
                    "type": "string",
                    "required": true
                },
                "enable": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                    "required": true
                },
                "s3port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "required": true
                },
                "rpcport": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "required": true
                },
                "s3region": {
                    "type": "string",
                    "required": true,
                    "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
                },
                "s3rootdomain": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^(\\.?[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*)?$"
                },
                "webenable": {
                    "type": "boolean"
                },
                "webport": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "required": true
                },
                "webrootdomain": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^(\\.?[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*)?$"
                },
                "adminport": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "required": true
                },
                "dbengine": {
                    "type": "string",
                    "enum": [
                        "lmdb",
                        "sqlite"
                    ],
                    "required": true
                },
                "compressionlevel": {
                    "type": "integer",
                    "minimum": -99,
                    "maximum": 22,
                    "required": true
                },
                "compressiondisable": {
                    "type": "boolean"
                },
                "snapshotinterval": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^([0-9]+(\\.[0-9]+)? *[a-z]+ *)*$"
                },
                "metadatashareuuid": {
                    "type": "string"
                },
                "snapshotsshareuuid": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "metadatafsync": {
                    "type": "boolean"
                },
                "datafsync": {
                    "type": "boolean"
                },
                "disablescrub": {
                    "type": "boolean"
                },
                "loglevel": {
                    "type": "string",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                    ],
                    "required": true
                },
                "blocksize": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^([0-9]+|[0-9]+(\\.[0-9]+)? *([kKmMgGtTpPeE][iI]?[bB]?|[bB]))?$"
                },
                "blockrambuffermax": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^([0-9]+|[0-9]+(\\.[0-9]+)? *([kKmMgGtTpPeE][iI]?[bB]?|[bB]))?$"
                },
                "blockmaxconcurrentreads": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "maximum": 1024
                },
                "blockmaxconcurrentwrites": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1,
                    "maximum": 1024
                },
                "lmdbmapsize": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^([0-9]+|[0-9]+(\\.[0-9]+)? *([kKmMgGtTpPeE][iI]?[bB]?|[bB]))?$"
                },
                "webuienable": {
                    "type": "boolean"
                },
                "webuiuser": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+$"
                },
                "storageshareuuid": {
                    "type": "string",
                    "required": true
                },
                "storagesplit": {
                    "type": "boolean"
                },
                "storagecapacity": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                }
            }
        }
    },
    {
        "type": "rpc",
        "id": "rpc.garage.setdatastore",
        "params": {
            "type": "object",
            "properties": {
                "uuid": {
                    "type": "string",
                    "required": true
                },
                "instanceuuid": {
                    "type": "string",
                    "format": "uuidv4",
                    "required": true
                },
                "shareuuid": {
                    "type": "string",
                    "required": true
                },
                "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "required": true
                }
            }
        }
    },
    {
        "type": "rpc",
