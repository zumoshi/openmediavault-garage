{
	"type": "config",
	"id": "conf.service.garage.mapping",
	"title": "Garage key-bucket mapping",
	"queryinfo": {
		"xpath": "/config/services/garage/mappings/mapping",
		"iterable": true,
		"idproperty": "uuid"
	},
	"properties": {
		"uuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"instanceuuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"keyuuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"bucketuuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"allowread": {
			"type": "boolean",
			"default": true
		},
		"allowwrite": {
			"type": "boolean",
			"default": true
		},
		"allowowner": {
			"type": "boolean",
			"default": false
		}
	}
}