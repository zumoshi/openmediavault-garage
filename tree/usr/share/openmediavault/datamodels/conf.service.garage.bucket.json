{
	"type": "config",
	"id": "conf.service.garage.bucket",
	"title": "Garage bucket",
	"queryinfo": {
		"xpath": "/config/services/garage/buckets/bucket",
		"iterable": true,
		"idproperty": "uuid"
	},
	"properties": {
		"uuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"instanceuuid": {
			"type": "string",
			"format": "uuidv4"
		},
		"name": {
			"type": "string",
			"minLength": 3,
			"maxLength": 63,
			"pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
		},
		"garageid": {
			"type": "string",
			"maxLength": 64,
			"default": ""
		},
		"maxsize": {
			"type": "number",
			"minimum": 0,
			"default": 0
		},
		"maxobjects": {
			"type": "integer",
			"minimum": 0,
			"default": 0
		},
		"website": {
			"type": "boolean",
			"default": false
		},
		"indexdoc": {
			"type": "string",
			"maxLength": 255,
			"default": ""
		},
		"errordoc": {
			"type": "string",
			"maxLength": 255,
			"default": ""
		}
	}
}